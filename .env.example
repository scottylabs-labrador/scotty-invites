# Postgres
DATABASE_URL="postgres://postgres:postgres@localhost:5433/scottylabs_invites"

# Mailgun (MAIL_MODE=console logs emails + codes to stdout for local dev)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mail.scottylabs.org"
MAILGUN_FROM_EMAIL="ScottyLabs Scotty Invite <noreply@mail.scottylabs.org>"
MAILGUN_REGION="us"
# MAIL_MODE="console"

# Public origins
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
MCP_PUBLIC_URL="http://localhost:4100/mcp"
# COOKIE_DOMAIN=".invite.scottylabs.org"   # only for split-domain deploys
# CORS_ORIGINS="https://invite.scottylabs.org"

# Secrets & seeds
TRANSFER_LINK_SECRET="change-me-48-random-chars"
SEED_SUPER_ADMIN_EMAILS="you@example.com"

# APP_MODE=mcp turns this process into the MCP server instead of the API

